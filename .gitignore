# ESP-IDF build output
build/
managed_components/
# dependencies.lock is committed: it pins the managed components (mdns) for every build
sdkconfig
sdkconfig.old
# keep sdkconfig.defaults (tracked)

# secrets (WiFi password, API token) - never commit
secrets.*
*.secret
firmware/**/main/secrets.h

# editors / OS
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Python tools
__pycache__/
.venv/
# bed scans from tools/scan_bed.py (photos, collages, calibration)
scans/

# per-machine VS Code settings (absolute paths)
firmware/.vscode/

# Tracked defaults. sdkconfig itself is generated and ignored by git.
CONFIG_IDF_TARGET="esp32s3"

# Board: ESP32-S3 (QFN56) rev v0.2, 8 MB flash, 8 MB embedded PSRAM (PSRAM not enabled yet).
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# Two OTA slots, see partitions.csv
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The board is used through its native USB port (USB Serial/JTAG, COM7).
# Primary console there, so the monitor can also send input (temporary G-code console).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

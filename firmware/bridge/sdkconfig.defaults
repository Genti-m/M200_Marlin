# Tracked defaults. sdkconfig itself is generated and ignored by git.
CONFIG_IDF_TARGET="esp32s3"

# Board: ESP32-S3 (QFN56) rev v0.2, 8 MB flash, 8 MB embedded PSRAM (PSRAM not enabled yet).
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# Two OTA slots, see partitions.csv
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The board is used through its native USB port (USB Serial/JTAG, COM7).
# Primary console there, so the monitor can also send input (temporary G-code console).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Milestone 3/4: WiFi, web server
CONFIG_HTTPD_WS_SUPPORT=y
# ESP-IDF 6 calls the WebSocket handler no more for the handshake: web_server.c uses these
# hooks for the Origin check (pre) and the hello message (post).
CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT=y
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y
# The web/state handlers run in the default event loop task: more stack and a longer queue
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_SYSTEM_EVENT_QUEUE_SIZE=64

# OTA rollback: a new image must confirm itself (main.c, once WiFi is up), else the bootloader
# boots the previous one. Lives in the bootloader: flash once over USB after changing it.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
